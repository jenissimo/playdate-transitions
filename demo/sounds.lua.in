-- Per-transition sound effects, written as sfxkit recipes.
--
-- This file is the demo's dogfood: the same 21 sounds the demo always had, but
-- as data rather than as 21 hand-written functions each poking five
-- module-scope synths. What that buys, concretely:
--
--   * the synths are allocated by SfxKit.load, not at import time;
--   * two sounds triggered in one frame cannot delete each other's notes,
--     because the allocator hands out voices instead of everyone sharing `n1`;
--   * the whole palette can be validated in a host test.
--
-- Built by tools/build_demo.py into demo/Source/sounds.lua.
TransitionSounds = {}
TransitionSounds.enabled = true

local SfxKit = rawget(_G, "SfxKit") or require("sfxkit")

TransitionSounds.SPEC = {
    buses = { fx = { volume = 1.0 } },
    groups = {
        -- Two noise voices because nearly every sound here is a noise pair;
        -- one each of the pitched waves, which no recipe uses twice.
        noise = { wave = "noise",    count = 2, bus = "fx" },
        sq    = { wave = "square",   count = 1, bus = "fx" },
        si    = { wave = "sine",     count = 1, bus = "fx" },
        tr    = { wave = "triangle", count = 1, bus = "fx" },
    },
    budget = { synth = 2, sample = 1 },
}

-- { group, attack, decay, sustain, release, volume, hz forward, hz back, length }
--
-- The volumes are the original's setVolume x velocity folded into one number:
-- a recipe note carries its own amplitude, so there is no per-synth gain left
-- to drift out of sync with it.
