TransitionSounds.FX = FX

-- One function recipe per effect, closing over its row. Direction only ever
-- changes the pitches, which is why the whole table is two Hz columns rather
-- than two tables.
local function recipe_for(rows)
    return function(dir)
        local fwd = (dir ~= "back")
        local notes = {}
        for i, r in ipairs(rows) do
            notes[i] = {
                group = r[1],
                adsr  = { r[2], r[3], r[4], r[5] },
                vol   = r[6],
                hz    = fwd and r[7] or r[8],
                len   = r[9],
            }
        end
        return { prio = 1, notes = notes }
    end
end

function TransitionSounds.load()
    SfxKit.load(TransitionSounds.SPEC)
    for name, rows in pairs(FX) do
        SfxKit.define("t:" .. name, recipe_for(rows))
    end
end

function TransitionSounds.play(name, dir)
    if not TransitionSounds.enabled then return false end
    return SfxKit.emit("t:" .. name, dir or "fwd")
end

return TransitionSounds
